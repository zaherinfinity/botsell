{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.py": {
      "maxDuration": 60,
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/webhook" },
    { "source": "/admin", "destination": "/api/webhook" },
    { "source": "/debug", "destination": "/api/webhook?action=debug" }
  ]
}
